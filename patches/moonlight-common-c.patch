+// Returns true if the RTSP response in buffer[0..len) is complete, i.e. the
+// header block ("\r\n\r\n") and any Content-Length body have all been received.
+static bool isRtspResponseComplete(const char* buffer, int len) {
+    int i;
+    int headerEnd = -1;
+
+    // Find the end of the headers ("\r\n\r\n").
+    for (i = 0; i + 3 < len; i++) {
+        if (buffer[i] == '\r' && buffer[i + 1] == '\n' &&
+            buffer[i + 2] == '\r' && buffer[i + 3] == '\n') {
+            headerEnd = i + 4;
+            break;
+        }
+    }
+    if (headerEnd < 0) {
+        // Headers are not complete yet.
+        return false;
+    }
+
+    // Parse the Content-Length header if present (Sunshine emits "Content-Length: N").
+    int contentLength = 0;
+    const char* cl = strstr(buffer, "Content-Length:");
+    if (cl != NULL && cl < buffer + headerEnd) {
+        contentLength = atoi(cl + 15);
+    }
+
+    return len >= headerEnd + contentLength;
+}
