diff --git a/unix.c b/unix.c
index 5ad7ca9..01a082a 100644
--- a/unix.c
+++ b/unix.c
@@ -28,6 +28,23 @@
 #define ENET_BUILDING_LIB 1
 #include "enet/enet.h"
 
+#ifdef __WII__
+#include <stdio.h>
+#include <stdarg.h>
+/* Socket-level ENet failures go to moonlight.log (timestamped, in order with
+ * everything else) through the app's shared logger in main.c. */
+extern void app_logv(const char *fmt, va_list ap);
+static void enet_log(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    app_logv(fmt, ap);
+    va_end(ap);
+}
+#define ENET_LOG(...) enet_log(__VA_ARGS__)
+#else
+#define ENET_LOG(...) ((void)0)
+#endif
+
 #if defined(__APPLE__)
 #if !defined(IPV6_RECVPKTINFO) || !defined(IPV6_PKTINFO)
 #warning Missing IPv6 socket option definitions. Is __APPLE_USE_RFC_3542 defined?
@@ -165,6 +182,25 @@
