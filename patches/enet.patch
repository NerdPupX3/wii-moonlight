     0,
@@ -1085,8 +1095,29 @@ enet_protocol_handle_incoming_commands (ENetHost * host, ENetEvent * event)
        
     if (peer != NULL)
     {
-       memcpy(& peer -> address, & host -> receivedPeerAddress, sizeof (host -> receivedPeerAddress));
-       memcpy(& peer -> localAddress, & host -> receivedLocalAddress, sizeof (host -> receivedLocalAddress));
+#ifdef __WII__
+       /* Wii port: the host is IPv4. Never let a received packet overwrite the
+        * peer's address with something that isn't IPv4 (a bad address makes the
+        * next sendto() fail with EINVAL and drops the control connection).
+        * Log the raw address so we can see what arrived. */
+       if (host -> receivedPeerAddress.address.ss_family != AF_INET)
+       {
+          static unsigned badAddr = 0;
+          const unsigned char * b = (const unsigned char *) & host -> receivedPeerAddress.address;
+          badAddr ++;
+          if (badAddr <= 10 || badAddr % 100 == 0)
+            ENET_WII_LOG("[enet] receive: ignored non-IPv4 sender address (count %u): "
+                         "family=%d len=%d bytes=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+                         badAddr, (int) host -> receivedPeerAddress.address.ss_family,
+                         (int) host -> receivedPeerAddress.addressLength,
+                         b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+       }
+       else
+#endif
+       {
+          memcpy(& peer -> address, & host -> receivedPeerAddress, sizeof (host -> receivedPeerAddress));
+          memcpy(& peer -> localAddress, & host -> receivedLocalAddress, sizeof (host -> receivedLocalAddress));
+       }
        peer -> incomingDataTotal += host -> receivedDataLength;
     }
     
