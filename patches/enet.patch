-typedef int socklen_t;
+// typedef int socklen_t;
 #endif
 
 #ifndef SOMAXCONN
 #define SOMAXCONN 128
 #endif
 
-#ifndef MSG_NOSIGNAL
+#if defined(__WII__)
+// The Wii IOS SO_SENDTO/SO_RECVFROM ioctls reject MSG_NOSIGNAL (0x20000) with
+// EOPNOTSUPP (errno 95). There are no signals (no SIGPIPE) on the Wii, so this
+// flag is meaningless here and must be forced to 0.
+#undef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#elif !defined(MSG_NOSIGNAL)
 #define MSG_NOSIGNAL 0
 #endif
 
@@ -653,8 +695,32 @@ enet_socket_send (ENetSocket socket,
         sendLength = buffers[0].dataLength;
     }
 
+    socklen_t usedTolen = peerAddress -> addressLength;
+#if defined(__WII__)
+    // The Wii IOS SO_SENDTO rejects a sockaddr larger than its 28-byte
+    // destaddr buffer with EOVERFLOW (139). The peer's addressLength gets
+    // polluted with sizeof(sockaddr_storage) by the receive path (which memcpy's
+    // the whole ENetAddress), so force the correct 8-byte IPv4 length here.
+    // The sockaddr's sin_len byte is already 8 (set by resolveHostName / recvfrom).
+    socklen_t wiiTolen = peerAddress -> addressLength;
+    if (peerAddress -> address.ss_family == AF_INET)
+      wiiTolen = sizeof (struct sockaddr_in) - sizeof (((struct sockaddr_in *) 0) -> sin_zero);
+    usedTolen = wiiTolen;
+    sentLength = sendto (socket, sendBuffer, sendLength, MSG_NOSIGNAL,
+        (struct sockaddr *) & peerAddress -> address, wiiTolen);
+#else
     sentLength = sendto (socket, sendBuffer, sendLength, MSG_NOSIGNAL,
         (struct sockaddr *) & peerAddress -> address, peerAddress -> addressLength);
+#endif
+    if (sentLength < 0)
+    {
+      const unsigned char * b = (const unsigned char *) & peerAddress -> address;
+      ENET_LOG("[enet] sendto failed: errno %d, tolen %d, peer family=%d addressLength=%d "
+               "bytes=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+               errno, (int) usedTolen, (int) peerAddress -> address.ss_family,
+               (int) peerAddress -> addressLength,
+               b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+    }
 
     if (bufferCount > 1)
       free(sendBuffer);
@@ -771,7 +837,27 @@ enet_socket_receive (ENetSocket socket,
 #ifdef NO_MSGAPI
     // This will ONLY work with a single buffer!
 
+#if defined(__WII__)
+    // The Wii IOS SO_RECVFROM rejects a fromlen larger than the max sockaddr it
+    // handles (28 bytes, see sendto_params.destaddr[28]). sizeof(sockaddr_storage)
+    // is 128+, which trips EINVAL. Use the max real sockaddr size instead.
+    peerAddress -> addressLength = sizeof (struct sockaddr_in6);
+
+    // The Wii IOS's non-blocking socket mode is also unreliable — recvfrom() can
+    // block even after ioctl(FIONBIO). Poll first so we never block on an empty
+    // socket (return 0 = no data, like EWOULDBLOCK).
+    {
+        struct pollfd pfd;
+        pfd.fd = socket;
+        pfd.events = POLLIN;
+        pfd.revents = 0;
+        if (poll(&pfd, 1, 0) <= 0) {
+            return 0;
+        }
+    }
+#else
     peerAddress -> addressLength = sizeof (peerAddress -> address);
+#endif
     recvLength = recvfrom (socket, buffers[0].data, buffers[0].dataLength, MSG_NOSIGNAL,
         (struct sockaddr *) & peerAddress -> address, & peerAddress -> addressLength);
 
@@ -780,6 +866,7 @@ enet_socket_receive (ENetSocket socket,
        if (errno == EWOULDBLOCK)
          return 0;
 
+       ENET_LOG("[enet] recvfrom failed: errno %d, fromlen %d\n", errno, (int) peerAddress -> addressLength);
        return -1;
     }
 
@@ -910,6 +997,17 @@ enet_socket_wait (ENetSocket socket, enet_uint32 * condition, enet_uint32 timeou
         }
         svcSleepThread(1000);
     }
+#elif defined(__WII__)
+    // poll(timeout) blocks forever on the Wii IOS for small (non-zero) timeouts,
+    // so emulate the timeout with a non-blocking poll + sleep loop like the 3DS.
+    enet_uint32 poll_start = enet_time_get();
+    for (enet_uint32 i = poll_start; (i - poll_start) < timeout; i = enet_time_get()) {
+        pollCount = poll(& pollSocket, 1, 0);
+        if (pollCount) {
+            break;
+        }
+        usleep(1000);
+    }
 #else
     pollCount = poll (& pollSocket, 1, timeout);
 #endif
@@ -923,6 +1021,7 @@ enet_socket_wait (ENetSocket socket, enet_uint32 * condition, enet_uint32 timeou
             return 0;
         }
 
+        ENET_LOG("[enet] poll failed: errno %d\n", errno);
         return -1;
     }
 
